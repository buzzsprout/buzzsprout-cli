#!/usr/bin/env bash
# Print a Homebrew formula for a tagged release.
# Usage: script/homebrew-formula X.Y.Z SHA256
set -euo pipefail

version="${1:-}"
sha="${2:-}"

if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || ! "$sha" =~ ^[0-9a-f]{64}$ ]]; then
  printf 'usage: script/homebrew-formula X.Y.Z SHA256\n' >&2
  exit 1
fi

cat <<EOF
class BuzzsproutCli < Formula
  desc "Command-line interface for the Buzzsprout API"
  homepage "https://github.com/buzzsprout/buzzsprout-cli"
  url "https://github.com/buzzsprout/buzzsprout-cli/archive/refs/tags/v${version}.tar.gz"
  sha256 "${sha}"
  license "MIT"

  depends_on "ruby"

  def install
    ENV["GEM_HOME"] = libexec
    system "gem", "build", "buzzsprout-cli.gemspec"
    system "gem", "install", "--ignore-dependencies", "--no-document", "buzzsprout-cli-#{version}.gem"
    (bin/"buzzsprout").write_env_script libexec/"bin/buzzsprout", GEM_HOME: libexec
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/buzzsprout version")
    assert_match "episodes", shell_output("#{bin}/buzzsprout skills list")
  end
end
EOF
